{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/resurrector",
      "destination": "/resurrector.html"
    },
    {
      "source": "/zombiecheck",
      "destination": "/api/zombiecheck-preview",
      "has": [{ "type": "query", "key": "npub" }]
    },
    {
      "source": "/zombiecheck",
      "destination": "/api/zombiecheck-preview",
      "has": [{ "type": "query", "key": "pubkey" }]
    },
    {
      "source": "/zombiecheck",
      "destination": "/zombiecheck.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
